{
  "manifest_version": 3,
  "name": "Marksly: Bookmark Organizer",
  "version": "1.0.0",
  "description": "Tidy your bookmarks in a few clicks. See every move first, undo anytime. Runs on your device: no account, no upload.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["bookmarks", "storage"],
  "optional_permissions": ["history"],
  "action": {
    "default_title": "Organize bookmarks with Marksly",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
